{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sequence.json",
  "description": "A library template bound to THIS campaign. The template says touch 2 leans on a new angle; this says which angle, from this campaign's pain map. gtme-write then fills each bound touch per contact. Three layers - shape, binding, personalization - and collapsing any two of them is what left messages being drafted with no idea what each touch was for.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "template_id",
    "template_version",
    "selection_rationale",
    "channels_verified",
    "touches",
    "volume_ceiling"
  ],
  "properties": {
    "status": {
      "enum": [
        "draft",
        "confirmed"
      ]
    },
    "confirmed_by": {
      "type": "string"
    },
    "confirmed_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "template_id": {
      "type": "string",
      "description": "Filename stem in gtme-sequence/templates/."
    },
    "template_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Pinned. gtme-measure attributes outcomes to a template version, which is the only thing that lets the library improve rather than drift."
    },
    "selection_rationale": {
      "type": "string",
      "minLength": 40,
      "description": "Why this template against channel-plan.json and the ICP. Selecting multichannel when LinkedIn is unwired puts a hole in the plan and calls it a touch."
    },
    "channels_verified": {
      "type": "array",
      "minItems": 1,
      "description": "Each channel the template requires, checked against channel-plan.json for actually being wired. An unwired channel blocks the gate.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel",
          "wired",
          "evidence"
        ],
        "properties": {
          "channel": {
            "type": "string"
          },
          "wired": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string",
            "minLength": 10
          },
          "daily_cap": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "touches": {
      "type": "array",
      "minItems": 1,
      "description": "One entry per template touch, in order, carrying the campaign-specific binding. gtme-write reads these; a touch with no binding gives the writer a slot and no brief.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "n",
          "channel",
          "day_offset",
          "intent",
          "leans_on",
          "ask",
          "word_max"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "channel": {
            "type": "string"
          },
          "day_offset": {
            "type": "integer",
            "minimum": 0
          },
          "intent": {
            "type": "string",
            "minLength": 15,
            "description": "What this touch is FOR, carried from the template. The thing gtme-write had no access to."
          },
          "leans_on": {
            "enum": [
              "pain",
              "objection",
              "proof",
              "new_angle",
              "signal",
              "breakup",
              "none"
            ]
          },
          "ask": {
            "enum": [
              "micro_commitment",
              "permission_to_send",
              "connect",
              "explicit_close",
              "none"
            ]
          },
          "word_max": {
            "type": "integer",
            "minimum": 0
          },
          "binds": {
            "type": "object",
            "additionalProperties": false,
            "description": "The campaign-specific content this touch draws on. Ids, never prose - a paraphrase here is a second copy of the pain map.",
            "properties": {
              "pain_id": {
                "type": "string",
                "pattern": "^pain:[a-z_]+$"
              },
              "objection_id": {
                "type": "string",
                "pattern": "^obj\\d+$"
              },
              "front_end_offer": {
                "type": "string",
                "pattern": "^f\\d+$"
              },
              "problem_id": {
                "type": "string",
                "pattern": "^p\\d+$"
              }
            }
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires": {
            "type": "string",
            "description": "A precondition from an earlier touch, e.g. a connection being accepted."
          },
          "skip_if_unmet": {
            "type": "boolean",
            "default": true
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "leans_on": {
                  "enum": [
                    "pain",
                    "objection"
                  ]
                }
              },
              "required": [
                "leans_on"
              ]
            },
            "then": {
              "required": [
                "binds"
              ],
              "description": "A touch that leans on a pain or an objection must name which one. Without it the writer picks, and the arc stops being a decision."
            }
          }
        ]
      }
    },
    "send_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "skip"
      ],
      "description": "A campaign rule, resolved to a real timestamp per contact at send time. 'Recipient-local 09:00-11:00' is the rule; Tuesday 09:40 New York is the materialization.",
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 10
        },
        "skip": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timezone_source": {
          "type": "string",
          "description": "Where the contact's local time comes from. Absent means the sender's timezone is being used as a stand-in, which is a real approximation and should be recorded."
        }
      }
    },
    "volume_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "touches_per_contact",
        "binding_channel",
        "daily_cap",
        "max_contacts_in_flight",
        "derivation"
      ],
      "description": "Touch count times contacts against the daily cap is the real list ceiling, and nothing computed it before. Five touches at 30 sends a day is a very different campaign from two.",
      "properties": {
        "touches_per_contact": {
          "type": "integer",
          "minimum": 1
        },
        "binding_channel": {
          "type": "string",
          "description": "The channel that runs out first."
        },
        "daily_cap": {
          "type": "integer",
          "minimum": 1
        },
        "max_contacts_in_flight": {
          "type": "integer",
          "minimum": 1
        },
        "derivation": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "branches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "on",
          "action"
        ],
        "properties": {
          "on": {
            "enum": [
              "reply_interested",
              "reply_negative",
              "reply_any",
              "no_reply",
              "meeting_booked",
              "signal_expired"
            ]
          },
          "action": {
            "enum": [
              "advance",
              "stop_cold",
              "stop_all"
            ]
          },
          "route_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "adaptations": {
      "type": "array",
      "description": "Every deviation from the template, with a reason. A run that silently edits a template breaks the thing that makes a library compound: gtme-measure can no longer attribute an outcome to a known shape.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "from",
          "to",
          "why"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "from": {},
          "to": {},
          "why": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "confirmed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "confirmed_by",
          "confirmed_at"
        ]
      }
    }
  ]
}
